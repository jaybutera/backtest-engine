# Build artifacts
target/
__pycache__/
*.pyc
.venv/
*.egg-info/
dist/
build/
.ruff_cache/
.pytest_cache/

# Secrets
.env
.env.*
!.env.example

# Market data. The engine reads parquet from here; none of it is
# distributable, and most of it is licensed per-user by the vendor.
data/

# Backtest output
*.json.tmp
ensemble_runs/

# Local tooling state and experiment worktrees
.claude/
# A data symlink (the data/ rule above covers a directory, not a link)
/data

# Private strategy presets, cloned from a separate private repo (see README
# "Private strategies"). The demo presets beside it are committed; everything
# under this directory is not, and must never be.
/config/strategy/private/
